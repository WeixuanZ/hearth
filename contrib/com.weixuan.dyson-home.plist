<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.weixuan.dyson-home</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/YOU/.cargo/bin/dyson-home</string>
		<string>run</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/Users/YOU/Library/Logs/dyson-home.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/YOU/Library/Logs/dyson-home.log</string>
</dict>
</plist>
